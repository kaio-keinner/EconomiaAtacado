# Node Environment
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App Core Configuration
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session Management
SESSION_DRIVER=cookie

# CORS Configuration
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database Configuration (SQLite or MySQL)
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=produtos_user
DB_PASSWORD=produtos_pass
DB_DATABASE=produtos_db

# Scraper & Feature Flags
SCRAPER_MOCK_MODE=false

# Third-Party External APIs
BIGMASTER_API_URL=http://soubig.appce.com.br/api
ATACADAO_GRAPHQL_URL=https://www.atacadao.com.br/api/graphql
ATACADAO_REGION_ID=U1cjYXRhY2FkYW9icjYw
ATACADAO_SELLER=atacadaobr60

# Redis Cache & Queue (Future Infrastructure)
# REDIS_URL=redis://127.0.0.1:6379

# Object Storage (Future S3 / MinIO Integration)
# S3_BUCKET=produtos-app-assets
# S3_REGION=us-east-1
# S3_ENDPOINT=          # Apenas para R2/B2/MinIO. Ex: https://<accountId>.r2.cloudflarestorage.com
# S3_PUBLIC_URL=        # URL pública do CDN/bucket. Ex: https://cdn.meusite.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Billing & Payments (Future Expansion)
# STRIPE_SECRET_KEY=